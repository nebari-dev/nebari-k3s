# Example Staging Inventory
#
# For staging/development environments
# Copy this file to staging.ini and customize:
#   cp inventory/examples/staging.ini.example inventory/staging.ini

# Single-node development cluster
[k3s_master]
staging-master ansible_host=192.168.1.100 ansible_user=vagrant

[k3s_worker]
staging-worker1 ansible_host=192.168.1.101 ansible_user=vagrant

[k3s_cluster:children]
k3s_master
k3s_worker

[k3s_cluster:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_become=true
ansible_become_method=sudo
ansible_ssh_private_key_file=~/.vagrant.d/insecure_private_key

# Staging-specific overrides
k3s_expose_nodeports_publicly=true  # Allow for testing
