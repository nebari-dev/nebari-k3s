# Example Production Inventory
#
# Copy this file to production.ini and customize for your environment:
#   cp inventory/examples/production.ini.example inventory/production.ini
#
# Then edit inventory/production.ini with your actual hosts and IPs

# K3s Master Nodes (Control Plane)
# These nodes run the Kubernetes API server, scheduler, and controller-manager
[k3s_master]
master1 ansible_host=10.11.0.10 ansible_user=ubuntu
master2 ansible_host=10.11.0.11 ansible_user=ubuntu
master3 ansible_host=10.11.0.12 ansible_user=ubuntu

# K3s Worker Nodes (Agent)
# These nodes run workloads (pods)
[k3s_worker]
worker1 ansible_host=10.11.0.20 ansible_user=ubuntu
worker2 ansible_host=10.11.0.21 ansible_user=ubuntu
worker3 ansible_host=10.11.0.22 ansible_user=ubuntu

# Combined group of all K3s nodes
[k3s_cluster:children]
k3s_master
k3s_worker

# Variables applied to all cluster nodes
[k3s_cluster:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_become=true
ansible_become_method=sudo
ansible_ssh_common_args='-o StrictHostKeyChecking=no'

# Optional: Variables for specific groups
[k3s_master:vars]
# k3s_server_init=true

[k3s_worker:vars]
# k3s_agent_args=["--node-label=node.kubernetes.io/instance-type=worker"]
