Vagrant.configure("2") do |config|
  config.vm.box = ENV.fetch("ROCKY_BOX_NAME", "rocky9-libvirt")
  config.vm.box_url = ENV["ROCKY_BOX_URL"] # optional but recommended
  config.ssh.insert_key = false

  CPUS = (ENV["CPUS"] || "2").to_i
  MEM  = (ENV["MEM"]  || "4096").to_i

  NET = ENV.fetch("NET", "192.168.56")
  VIP = ENV.fetch("VIP", "#{NET}.10")

  nodes = [
    { name: "cp1", ip: "#{NET}.11" },
    { name: "cp2", ip: "#{NET}.12" },
    { name: "cp3", ip: "#{NET}.13" },
    { name: "w1",  ip: "#{NET}.21" },
    { name: "w2",  ip: "#{NET}.22" },
  ]

  nodes.each do |n|
    config.vm.define n[:name] do |vm|
      vm.vm.hostname = n[:name]
      vm.vm.synced_folder ".", "/vagrant", disabled: true

      # Linux/libvirt can do static private_network easily
      vm.vm.provider "libvirt" do |lv|
        vm.vm.network "private_network", ip: n[:ip]
        lv.cpus = CPUS
        lv.memory = MEM
      end

      # macOS/qemu: still set resources; networking handled in bootstrap (set IP inside guest)
      vm.vm.provider "qemu" do |qe|
        qe.arch = "aarch64"
        qe.machine = "virt,accel=hvf"
        qe.cpu = "cortex-a72"
        qe.smp = CPUS.to_s
        qe.memory = "#{MEM}M"
        qe.ssh_auto_correct = true
        # Keep guests on a predictable subnet via user networking DHCP
        qe.extra_netdev_args = "net=#{NET}.0/24,dhcpstart=#{NET}.50"
      end

      vm.vm.provision "shell", path: "scripts/bootstrap.sh", env: {
        "STATIC_IP" => n[:ip],
        "VIP" => VIP
      }
    end
  end
end
