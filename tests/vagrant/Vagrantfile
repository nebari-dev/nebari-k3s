Vagrant.configure("2") do |config|
  config.vm.box = ENV.fetch("ROCKY_BOX_NAME", "generic/rocky9")
  config.vm.box_url = ENV["ROCKY_BOX_URL"] # optional but recommended
  config.ssh.insert_key = false

  # Increase boot timeout for slow CI environments
  config.vm.boot_timeout = 900  # 15 minutes for CI

  # SSH configuration for better reliability
  config.ssh.connect_timeout = 60  # Increased for CI
  config.ssh.forward_agent = false
  config.ssh.forward_x11 = false

  CPUS = (ENV["CPUS"] || "2").to_i
  MEM  = (ENV["MEM"]  || "2048").to_i  # Reduced for QEMU highmem=off limit

  NET = ENV.fetch("NET", "192.168.56")
  VIP = ENV.fetch("VIP", "#{NET}.10")

  nodes = [
    { name: "cp1", ip: "#{NET}.11", ssh_port: 50022 },
    { name: "w1",  ip: "#{NET}.21", ssh_port: 50023 },
    { name: "w2",  ip: "#{NET}.22", ssh_port: 50024 },
  ]

  nodes.each do |n|
    config.vm.define n[:name] do |vm|
      vm.vm.hostname = n[:name]
      vm.vm.synced_folder ".", "/vagrant", disabled: true

      # Network configuration (libvirt supports private_network)
      # Use vagrant-libvirt default network which is pre-configured
      vm.vm.network "private_network", 
        ip: n[:ip],
        libvirt__dhcp_enabled: true

      # Linux/libvirt provider
      vm.vm.provider "libvirt" do |lv|
        lv.cpus = CPUS
        lv.memory = MEM
        lv.default_prefix = "vagrant_"
      end

      # macOS/qemu: still set resources; networking handled in bootstrap (set IP inside guest)
      vm.vm.provider "qemu" do |qe|
        qe.arch = "aarch64"
        qe.machine = "virt,accel=hvf,highmem=off"
        qe.cpu = "host"
        qe.smp = CPUS
        qe.memory = MEM
        qe.net_device = "virtio-net-pci"
        qe.ssh_port = n[:ssh_port]
      end

      vm.vm.provision "shell", path: "scripts/bootstrap.sh", env: {
        "STATIC_IP" => n[:ip],
        "VIP" => VIP
      }
    end
  end
end
